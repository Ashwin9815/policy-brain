generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  folders          Folder[]
  policies         Policy[]
  knowledgeSources KnowledgeSource[]
  workflows        Workflow[]
  auditEvents      AuditEvent[]
  graphEdges       KnowledgeGraphEdge[]
  composerSessions ComposerSession[]
  exportRecords    ExportRecord[]
  flightRecords    FlightRecord[]
  settings         OrganizationSettings?
  policyVersions   PolicyVersion[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?  @map("password_hash")
  name           String
  role           UserRole @default(MEMBER)
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderPermissions  FolderPermission[]
  policiesCreated    Policy[]           @relation("PolicyCreator")
  rulesCreated       Rule[]             @relation("RuleCreator")
  comments           Comment[]
  approvals          Approval[]
  auditEvents        AuditEvent[]
  sessions           Session[]
  notifications      Notification[]
  composerSessions   ComposerSession[]
  exportRecords      ExportRecord[]

  @@index([organizationId])
  @@map("users")
}

enum UserRole {
  ADMIN
  MEMBER
  REVIEWER
  VIEWER
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Folders & RBAC ─────────────────────────────────────────────────────────

model Folder {
  id             String   @id @default(cuid())
  name           String
  description    String?
  parentId       String?  @map("parent_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Folder?            @relation("FolderHierarchy", fields: [parentId], references: [id])
  children     Folder[]           @relation("FolderHierarchy")
  permissions  FolderPermission[]
  policies     Policy[]
  sources      KnowledgeSource[]
  composerSessions ComposerSession[]

  @@index([organizationId])
  @@index([parentId])
  @@map("folders")
}

model FolderPermission {
  id         String           @id @default(cuid())
  folderId   String           @map("folder_id")
  userId     String           @map("user_id")
  permission FolderPermissionLevel
  createdAt  DateTime         @default(now()) @map("created_at")

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@map("folder_permissions")
}

enum FolderPermissionLevel {
  READ
  WRITE
  ADMIN
}

// ─── Policy & Rules ─────────────────────────────────────────────────────────

model Policy {
  id             String       @id @default(cuid())
  title          String
  description    String?
  status         PolicyStatus @default(DRAFT)
  folderId       String       @map("folder_id")
  organizationId String       @map("organization_id")
  createdById    String       @map("created_by_id")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  folder       Folder       @relation(fields: [folderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PolicyCreator", fields: [createdById], references: [id])
  rules        Rule[]
  approvals    Approval[]
  comments     Comment[]
  versions     PolicyVersion[]
  composerSessions ComposerSession[]

  @@index([organizationId])
  @@index([folderId])
  @@index([status])
  @@map("policies")
}

enum PolicyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Rule {
  id          String     @id @default(cuid())
  policyId    String     @map("policy_id")
  title       String
  description String?
  dslContent  Json       @map("dsl_content")
  status      RuleStatus @default(DRAFT)
  createdById String     @map("created_by_id")
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  policy    Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy User          @relation("RuleCreator", fields: [createdById], references: [id])
  versions  RuleVersion[]
  comments  Comment[]
  exports   ExportRecord[]
  graphEdgesFrom KnowledgeGraphEdge[] @relation("GraphFromRule")
  graphEdgesTo   KnowledgeGraphEdge[] @relation("GraphToRule")

  @@index([policyId])
  @@index([status])
  @@map("rules")
}

enum RuleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

model RuleVersion {
  id         String   @id @default(cuid())
  ruleId     String   @map("rule_id")
  version    Int
  dslContent Json     @map("dsl_content")
  changeNote String?  @map("change_note")
  createdAt  DateTime @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@map("rule_versions")
}

// ─── Knowledge Brain ──────────────────────────────────────────────────────────

model KnowledgeSource {
  id             String              @id @default(cuid())
  title          String
  fileName       String              @map("file_name")
  mimeType       String              @map("mime_type")
  fileSize       Int                 @map("file_size")
  storagePath    String              @map("storage_path")
  extractedText  String?             @map("extracted_text") @db.Text
  status         KnowledgeSourceStatus @default(PENDING)
  folderId       String              @map("folder_id")
  organizationId String              @map("organization_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  folder       Folder            @relation(fields: [folderId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objects      KnowledgeObject[]

  @@index([organizationId])
  @@index([folderId])
  @@map("knowledge_sources")
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  EXTRACTED
  FAILED
}

model KnowledgeObject {
  id         String   @id @default(cuid())
  sourceId   String   @map("source_id")
  type       String
  content    String
  metadata   Json     @default("{}")
  confidence Float    @default(0.0)
  createdAt  DateTime @default(now()) @map("created_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  edgesFrom KnowledgeGraphEdge[] @relation("GraphFromObject")
  edgesTo   KnowledgeGraphEdge[] @relation("GraphToObject")

  @@index([sourceId])
  @@map("knowledge_objects")
}

// ─── Workflows & Agents ─────────────────────────────────────────────────────

model Workflow {
  id             String         @id @default(cuid())
  type           WorkflowType
  status         WorkflowStatus @default(PENDING)
  input          Json           @default("{}")
  output         Json?
  organizationId String         @map("organization_id")
  correlationId  String         @map("correlation_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkpoints  WorkflowCheckpoint[]
  executions   AgentExecution[]

  @@index([organizationId])
  @@index([status])
  @@index([correlationId])
  @@map("workflows")
}

enum WorkflowType {
  DOCUMENT_INGESTION
  RULE_GENERATION
  DUPLICATE_CHECK
  RULE_COMPARISON
  IMPACT_ANALYSIS
  EXPORT
}

enum WorkflowStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model WorkflowCheckpoint {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  stage      String
  state      Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_checkpoints")
}

model AgentExecution {
  id         String              @id @default(cuid())
  workflowId String              @map("workflow_id")
  agentType  String              @map("agent_type")
  status     AgentExecutionStatus @default(PENDING)
  input      Json                @default("{}")
  output     Json?
  trace      Json?
  startedAt  DateTime?           @map("started_at")
  completedAt DateTime?          @map("completed_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("agent_executions")
}

enum AgentExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─── Collaboration & Governance ───────────────────────────────────────────────

model Approval {
  id         String         @id @default(cuid())
  policyId   String         @map("policy_id")
  approverId String         @map("approver_id")
  status     ApprovalStatus @default(PENDING)
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at")
  decidedAt  DateTime?      @map("decided_at")

  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approver User   @relation(fields: [approverId], references: [id])

  @@index([policyId])
  @@map("approvals")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id        String      @id @default(cuid())
  content   String
  type      CommentType @default(SUGGESTION)
  mentions  String[]    @default([])
  resolved  Boolean     @default(false)
  parentId  String?     @map("parent_id")
  authorId  String      @map("author_id")
  policyId  String?     @map("policy_id")
  ruleId    String?     @map("rule_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  policy Policy? @relation(fields: [policyId], references: [id], onDelete: Cascade)
  rule   Rule?   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  parent Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([policyId])
  @@index([ruleId])
  @@map("comments")
}

enum CommentType {
  QUESTION
  SUGGESTION
  ISSUE
  REQUEST
  APPROVAL_NOTE
  EVIDENCE
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String   @map("resource_id")
  metadata       Json     @default("{}")
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@map("audit_events")
}

// ─── Knowledge Graph ────────────────────────────────────────────────────────

model KnowledgeGraphEdge {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fromObjectId   String?  @map("from_object_id")
  fromRuleId     String?  @map("from_rule_id")
  toObjectId     String?  @map("to_object_id")
  toRuleId       String?  @map("to_rule_id")
  relation       String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromObject   KnowledgeObject? @relation("GraphFromObject", fields: [fromObjectId], references: [id], onDelete: Cascade)
  toObject     KnowledgeObject? @relation("GraphToObject", fields: [toObjectId], references: [id], onDelete: Cascade)
  fromRule     Rule?            @relation("GraphFromRule", fields: [fromRuleId], references: [id], onDelete: Cascade)
  toRule       Rule?            @relation("GraphToRule", fields: [toRuleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("knowledge_graph_edges")
}

// ─── Policy Versions ────────────────────────────────────────────────────────

model PolicyVersion {
  id             String       @id @default(cuid())
  policyId       String       @map("policy_id")
  organizationId String       @map("organization_id")
  version        Int
  title          String
  description    String?
  status         PolicyStatus
  snapshot       Json
  changeNote     String?      @map("change_note")
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  policy       Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([organizationId])
  @@map("policy_versions")
}

// ─── AI Composer ──────────────────────────────────────────────────────────────

model ComposerSession {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  folderId       String         @map("folder_id")
  policyId       String?        @map("policy_id")
  title          String?
  stage          ComposerStage  @default(UPLOAD)
  sourceIds      String[]       @default([])
  clarifications Json           @default("[]")
  generatedRules Json           @default("[]")
  metadata       Json           @default("{}")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       Folder       @relation(fields: [folderId], references: [id])
  policy       Policy?      @relation(fields: [policyId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("composer_sessions")
}

enum ComposerStage {
  UPLOAD
  EXTRACT
  CLARIFY
  GENERATE
  REVIEW
  COMPLETE
}

// ─── Exports ──────────────────────────────────────────────────────────────────

model ExportRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  ruleId         String   @map("rule_id")
  userId         String   @map("user_id")
  format         String
  artifact       String   @db.Text
  validation     Json     @default("{}")
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         Rule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([ruleId])
  @@map("export_records")
}

// ─── Flight Recorder ──────────────────────────────────────────────────────────

model FlightRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workflowId     String?  @map("workflow_id")
  correlationId  String   @map("correlation_id")
  stage          String
  agentType      String?  @map("agent_type")
  model          String?
  promptVersion  String?  @map("prompt_version")
  tokenUsage     Int      @default(0) @map("token_usage")
  status         String
  durationMs     Int      @default(0) @map("duration_ms")
  input          Json     @default("{}")
  output         Json?
  trace          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@index([correlationId])
  @@map("flight_records")
}

// ─── Organization Settings & Notifications ────────────────────────────────────

model OrganizationSettings {
  id                   String   @id @default(cuid())
  organizationId       String   @unique @map("organization_id")
  byokApiKey           String?  @map("byok_api_key")
  allowedModels        Json     @default("[\"gpt-4o\",\"gpt-4o-mini\"]") @map("allowed_models")
  tokenBudgetMonthly   Int      @default(1000000) @map("token_budget_monthly")
  mfaRequired          Boolean  @default(false) @map("mfa_required")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  confidenceThreshold  Float    @default(0.8) @map("confidence_threshold")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
