{
  "name": "policy-brain",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise AI Policy Compiler & Knowledge Platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @policy-brain/database generate",
    "db:migrate": "pnpm --filter @policy-brain/database migrate",
    "db:push": "pnpm --filter @policy-brain/database push",
    "db:seed": "pnpm --filter @policy-brain/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp"]
  }
}
